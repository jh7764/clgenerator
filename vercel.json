{
  "version": 2,
  "builds": [
    {
      "src": "utils/export.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/utils/(.*)",
      "dest": "utils/export.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}